<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_rop_products" model="ir.actions.act_window">
        <field name="name">ROP Products</field>
        <field name="res_model">stock.warehouse.orderpoint</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="domain">[('qty_to_order', '&gt;', 0)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No products below reorder point.
            </p>
        </field>
    </record>

    <record id="action_products_above_rop" model="ir.actions.act_window">
        <field name="name">Products &gt; ROP</field>
        <field name="res_model">stock.warehouse.orderpoint</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="domain">[('qty_to_order', '&lt;=', 0)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No products above reorder point.
            </p>
        </field>
    </record>

    <menuitem id="menu_rop_root"
        name="ROP"
        parent="stock.menu_stock_root"
        sequence="5"/>

    <menuitem id="menu_rop_products"
        name="ROP Products"
        parent="menu_rop_root"
        action="action_rop_products"
        sequence="1"/>

    <menuitem id="menu_products_above_rop"
        name="Products &gt; ROP"
        parent="menu_rop_root"
        action="action_products_above_rop"
        sequence="2"/>

</odoo>
