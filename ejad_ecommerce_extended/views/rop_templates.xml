<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="rop_products_page" name="ROP Products Page">
        <t t-call="website.layout">
            <div id="wrap" class="container oe_website_sale py-3">
                <h2 class="mb-4">ROP Products (Quantity &lt; 5)</h2>
                <t t-if="products">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Product</th>
                                <th>Internal Reference</th>
                                <th>Available Qty</th>
                                <th>Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="products" t-as="product">
                                <tr>
                                    <td>
                                        <img t-att-src="'/web/image/product.product/%s/image_128' % product.id"
                                             style="max-height:50px; max-width:50px;" alt="Product Image"/>
                                        <br/>
                                        <button type="button"
                                                class="btn btn-sm btn-primary mt-1 btn_update_qty"
                                                t-att-data-product-id="product.id"
                                                t-att-data-product-name="product.display_name"
                                                t-att-data-product-qty="product.qty_available">
                                            Update Product Quantity
                                        </button>
                                    </td>
                                    <td>
                                        <a t-att-href="'/shop/%s' % product.product_tmpl_id.id">
                                            <t t-out="product.display_name"/>
                                        </a>
                                    </td>
                                    <td><t t-out="product.default_code or ''"/></td>
                                    <td>
                                        <span class="badge bg-danger" t-if="product.qty_available &lt;= 0">
                                            <t t-out="product.qty_available"/>
                                        </span>
                                        <span class="badge bg-warning text-dark" t-else="">
                                            <t t-out="product.qty_available"/>
                                        </span>
                                    </td>
                                    <td><t t-out="product.lst_price"/> <t t-out="product.currency_id.symbol"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>
            </div>

            <div class="modal fade" id="updateQtyModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Update Product Quantity</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                        </div>
                        <div class="modal-body">
                            <p>Product: <strong id="modalProductName"></strong></p>
                            <p>Current Qty on Hand: <strong id="modalCurrentQty"></strong></p>
                            <div class="mb-3">
                                <label for="newQtyInput" class="form-label">New Quantity on Hand</label>
                                <input type="number" class="form-control" id="newQtyInput" min="0" step="1" required="required"/>
                            </div>
                            <input type="hidden" id="modalProductId"/>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-primary" id="btnApplyQty">Apply</button>
                        </div>
                    </div>
                </div>
            </div>

        </t>
    </template>

    <template id="rop_realtime_page" name="Real-time ROP Products Page">
        <t t-call="website.layout">
            <div id="wrap" class="container oe_website_sale py-3">
                <h2 class="mb-4">Real-time ROP (Quantity &gt; 5)</h2>
                <div id="rop_realtime_container">
                    <table class="table" id="rop_realtime_table">
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Product</th>
                                <th>Internal Reference</th>
                                <th>Available Qty</th>
                                <th>Price</th>
                            </tr>
                        </thead>
                        <tbody id="rop_realtime_tbody">
                            <t t-foreach="products" t-as="product">
                                <tr>
                                    <td>
                                        <img t-att-src="'/web/image/product.product/%s/image_128' % product.id"
                                             style="max-height:50px; max-width:50px;" alt="Product Image"/>
                                    </td>
                                    <td>
                                        <a t-att-href="'/shop/%s' % product.product_tmpl_id.id">
                                            <t t-out="product.display_name"/>
                                        </a>
                                    </td>
                                    <td><t t-out="product.default_code or ''"/></td>
                                    <td>
                                        <span class="badge bg-success">
                                            <t t-out="product.qty_available"/>
                                        </span>
                                    </td>
                                    <td><t t-out="product.lst_price"/> <t t-out="product.currency_id.symbol"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <div id="rop_realtime_empty" class="alert alert-warning" style="display:none;">
                        No products with quantity greater than 5.
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
